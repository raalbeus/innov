# Copy to .env and fill in. Never commit .env.

# --- Required -------------------------------------------------------------
# Random string, 32+ characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
ALLOWED_DOMAINS=vitrodc.com
# Extra addresses outside the domains above, comma-separated (keep real addresses out of the repository)
ALLOWED_EMAILS=
# Who may upload the reference files from the home page (SOURCE_MODE=local only)
ADMIN_EMAILS=
SESSION_HOURS=8
# true in production (HTTPS). false only for local http testing.
COOKIE_SECURE=true

# --- Microsoft 365 (Entra ID app registration, from IT) ----------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Sign-in code email: console (dev, code in server log) or graph
MAIL_MODE=graph
MAIL_SENDER=bidtool@vitrodc.com

# Reference folder: local or sharepoint
SOURCE_MODE=sharepoint
SHAREPOINT_HOST=vitrodc.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Solutions
SHAREPOINT_FOLDER=Bid Qualification/Reference
# LOCAL_REF_DIR=/srv/bidapp/reference   (SOURCE_MODE=local only)

# --- Claude API -----------------------------------------------------------------
AI_MODE=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# --- Storage ----------------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=200
